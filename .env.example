# Copy this file to .env and fill in real values. .env is git-ignored.
# NEVER commit real secret values. See docs/decision.md D-65, D-69.

GROQ_API_KEY=
GEMINI_API_KEY=
RUN_SIGNING_SECRET=

APP_TIMEZONE=Asia/Kolkata

MODEL_NORMALIZER=openai/gpt-oss-20b
MODEL_ANALYST=openai/gpt-oss-120b
MODEL_VERIFIER=qwen/qwen3.8-27b
MODEL_FALLBACK=gemini-3.5-flash

PARALLEL=true
# Gemini fallback (D-69/D-70) auto-enables when GEMINI_API_KEY is set above.
# Set DISABLE_FALLBACK=true to force it off even with a key configured.
DISABLE_FALLBACK=false
LLM_MODE=live
SERVE_STATIC=true
FORCE_AI_FAILURE=false
